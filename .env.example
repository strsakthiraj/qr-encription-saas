# --- Frontend (public; safe to ship to the browser) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Edge Function secrets (SERVER ONLY; set with `supabase secrets set`, never commit) ---
APP_URL=https://your-app.example.com
TELEGRAM_BOT_TOKEN=123456:ABC-from-BotFather
TELEGRAM_CHANNEL_ID=-1001234567890
STREAM_SIGNING_SECRET=generate-with-openssl-rand-hex-32
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically into Edge Functions.
